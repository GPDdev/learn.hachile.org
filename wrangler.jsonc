{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learn-video-classroom",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "learn-video-classroom", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "learn-classroom-media" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "APP_ORIGIN": "https://learn.hachile.org", "PAYMENT_MODE": "sandbox", "QWEN_MODEL": "qwen-plus" }
}
